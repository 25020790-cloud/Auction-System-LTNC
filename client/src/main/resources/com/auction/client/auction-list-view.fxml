<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.auction.client.AuctionListController"

        styleClass="root-pane"
        prefWidth="1200"
        prefHeight="800">

    <!-- Thanh điều hướng phía trên -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="top-nav">

            <Label text="LUXURY AUCTIONS"
                   styleClass="brand-logo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="⌕ Search"
                   styleClass="nav-icon"/>

            <Button text="👤 Hồ sơ"
                    onAction="#handleOpenProfile"
                    styleClass="profile-btn"/>

            <Label fx:id="balanceLabel"
                   text="💰 0 USD"
                   styleClass="balance-label"/>

            <Button text="Đăng xuất"
                    onAction="#handleLogout"
                    styleClass="logout-btn"/>

        </HBox>
    </top>

    <!-- Thanh danh mục bên trái -->
    <left>
        <VBox spacing="10"
              styleClass="sidebar"
              prefWidth="230">

            <Label text="Categories"
                   styleClass="filter-header"/>

            <Button fx:id="filterAll"
                    text="All Items"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn, filter-btn-active"
                    maxWidth="Infinity"/>

            <Button fx:id="filterWatches"
                    text="Watches"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="filterBags"
                    text="Bags"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="filterJewelry"
                    text="Jewelry"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="filterFineart"
                    text="Fine Art"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="filterElectronics"
                    text="Electronics"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="filterVehicles"
                    text="Vehicles"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="filterCollectibles"
                    text="Collectibles"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="filterOther"
                    text="Other"
                    onAction="#handleFilterCategory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Separator/>

            <Button fx:id="filterMyHistory"
                    text="My Bids"
                    onAction="#handleMyBidHistory"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Separator/>

            <Label text="Trạng thái phiên"
                   styleClass="filter-header"/>

            <Button fx:id="filterStatusAll"
                    text="📋 Tất cả"
                    onAction="#handleFilterStatus"
                    styleClass="filter-btn, filter-btn-active"
                    maxWidth="Infinity"/>

            <Button fx:id="filterStatusActive"
                    text="🟢 Đang hoạt động"
                    onAction="#handleFilterStatus"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Button fx:id="filterStatusEnded"
                    text="🔴 Đã kết thúc"
                    onAction="#handleFilterStatus"
                    styleClass="filter-btn"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="LUXURY • EXCLUSIVE • TRUSTED"
                   styleClass="sidebar-footer"/>

        </VBox>
    </left>

    <!-- Nội dung đấu giá -->
    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    styleClass="main-scroll-pane"
                    vbarPolicy="AS_NEEDED"
                    hbarPolicy="NEVER">

            <VBox spacing="24"
                  styleClass="main-content">

                <VBox spacing="8">
                    <Label text="EXCLUSIVE LUXURY AUCTIONS"
                           styleClass="page-title"/>

                    <Label text="Browse and bid on curated masterpieces"
                           styleClass="page-subtitle"/>
                </VBox>

                <Separator/>

                <VBox spacing="12">
                    <Label text="Available Auctions"
                           styleClass="section-title"/>

                    <!-- Controller sẽ thêm các thẻ sản phẩm vào đây -->
                    <FlowPane fx:id="productGrid"
                              hgap="20"
                              vgap="20"
                              columnHalignment="LEFT"
                              rowValignment="TOP"/>
                </VBox>

            </VBox>

        </ScrollPane>
    </center>

</BorderPane>
